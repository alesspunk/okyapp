{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "storybook-static",
  "rewrites": [
    {
      "source": "/prototypes/oky-cash-web/usa",
      "destination": "/prototypes/oky-cash-web/index.html"
    },
    {
      "source": "/prototypes/oky-cash-web/latam",
      "destination": "/prototypes/oky-cash-web/index.html"
    },
    {
      "source": "/prototypes/oky-cash-web/gua",
      "destination": "/prototypes/oky-cash-web/index.html"
    },
    {
      "source": "/oky-cash-prototype-demo.html",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/images/oky-cash-prototype-demo.html",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/images/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/prototypes/oky-cash/usa",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/prototypes/oky-cash/latam",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/prototypes/oky-cash/gua",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/atomic",
      "destination": "/public/ATOMIC-DESIGN-LIBRARY.html"
    },
    {
      "source": "/storybook",
      "destination": "/index.html"
    },
    {
      "source": "/storybook/oky-cash-prototype-demo.html",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/storybook/images/oky-cash-prototype-demo.html",
      "destination": "/prototypes/oky-cash/index.html"
    },
    {
      "source": "/storybook/images/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/storybook/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/prototypes/oky-cash-web/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
